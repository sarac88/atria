# Plantilla de variables para el despliegue.
# En el servidor:  cp .env.prod.example .env.prod  y rellenar.
# .env.prod NO se sube a git (está en .gitignore).

# ---- Dominio ----
# El dominio real que apunta a la IP elástica de la instancia.
# Caddy pide el certificado para este nombre.
# Para una prueba en HTTP sin dominio: DOMAIN=":80" (y COOKIE_SECURE="false").
DOMAIN="atria.ejemplo.com"

# Origen público de la app. Se usa para CORS, para el CORS del WebSocket y
# para construir los enlaces de invitación que van por correo.
APP_URL="https://atria.ejemplo.com"

# OJO: esto se hornea en el bundle de Next durante el build, no se lee en
# runtime. Si lo cambias, hay que reconstruir la imagen de web.
# Mismo origen que APP_URL, porque Caddy sirve front y API juntos.
NEXT_PUBLIC_API_URL="https://atria.ejemplo.com/api/v1"

# ---- Base de datos ----
# Generar con: openssl rand -hex 24
# Hexadecimal a propósito, NO base64: esta contraseña se inserta dentro de la
# URL de conexión (postgresql://atria:CONTRASEÑA@postgres:5432/...) y los
# caracteres "/", "+" y "=" que produce base64 romperían el parseo de la URL.
POSTGRES_PASSWORD=""

# ---- JWT ----
# Generar cada uno con: openssl rand -base64 32 (uno distinto para cada uno).
# Aquí base64 sí vale: no van dentro de ninguna URL.
# No reutilizar los de desarrollo.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Sólo ponlo a "false" si estás sirviendo por HTTP sin certificado.
COOKIE_SECURE="true"

# ---- Correo ----
# Vacío = no se envían invitaciones, sólo se comparten los enlaces a mano.
# Para una demo, la bandeja de pruebas de Mailtrap sigue valiendo.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Atria <no-reply@atria.edu>"
