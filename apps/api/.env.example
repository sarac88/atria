DATABASE_URL="postgresql://atria:atria@localhost:5432/atria?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# Origen del frontend usado para construir los enlaces de invitación (por defecto, CORS_ORIGIN).
APP_URL="http://localhost:3000"
# SMTP para los correos de invitación. En desarrollo, la bandeja de pruebas de
# Mailtrap: host y credenciales están en Email Testing → Inboxes → SMTP Settings.
# Si se deja vacío no se envían correos y sólo se comparten los enlaces a mano.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Atria <no-reply@atria.edu>"
COOKIE_SECURE="false"
