// Atria LMS — data model (architecture doc §5). This slice exposes only
// auth/users/classes, but the full relational model is defined so migrations
// stay stable across later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  docente
  alumno
  admin
}

enum ClassStatus {
  live
  scheduled
  draft
}

enum EnrollmentRole {
  teacher
  student
}

enum ActivityType {
  tarea
  cuestionario
  proyecto
  ensayo
  debate
}

enum SubmissionStatus {
  entregado
  pendiente
  atrasado
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               Role         @default(alumno)
  avatarUrl          String?
  hashedRefreshToken String?
  ownedClasses       Class[]      @relation("ClassOwner")
  enrollments        Enrollment[]
  submissions        Submission[]
  messages           Message[]
  gradesGiven        Grade[]      @relation("GradedBy")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Class {
  id            String         @id @default(cuid())
  name          String
  code          String
  room          String         @default("")
  subject       String         @default("")
  color         String         @default("var(--primary-500)")
  icon          String         @default("academic-cap")
  status        ClassStatus    @default(draft)
  progress      Float          @default(0)
  nextSession   String         @default("Sin programar")
  desc          String         @default("")
  studentsCount Int            @default(0)
  openActivities Int           @default(0)
  pending       Int            @default(0)
  ownerId       String
  owner         User           @relation("ClassOwner", fields: [ownerId], references: [id])
  enrollments   Enrollment[]
  modules       Module[]
  activities    Activity[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Enrollment {
  id          String         @id @default(cuid())
  userId      String
  classId     String
  roleInClass EnrollmentRole @default(student)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, classId])
}

model Module {
  id        String     @id @default(cuid())
  classId   String
  title     String
  position  Int        @default(0)
  done      Boolean    @default(false)
  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  resources Resource[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  moduleId  String
  type      String
  label     String
  meta      String   @default("")
  state     String   @default("")
  fileId    String?
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  file      File?    @relation(fields: [fileId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id           String       @id @default(cuid())
  classId      String
  type         ActivityType @default(tarea)
  title        String
  instructions String       @default("")
  dueAt        String       @default("")
  points       Int          @default(0)
  format       String       @default("Archivo")
  status       ClassStatus  @default(live)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Submission {
  id          String           @id @default(cuid())
  activityId  String
  studentId   String
  status      SubmissionStatus @default(pendiente)
  submittedAt DateTime?
  fileId      String?
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file        File?            @relation(fields: [fileId], references: [id])
  grade       Grade?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([activityId, studentId])
}

model Grade {
  id           String     @id @default(cuid())
  submissionId String     @unique
  score        Float
  feedback     String     @default("")
  gradedById   String?
  gradedAt     DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy     User?      @relation("GradedBy", fields: [gradedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  type      String    @default("direct")
  classId   String?
  title     String    @default("")
  class     Class?    @relation(fields: [classId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model File {
  id          String       @id @default(cuid())
  ownerId     String
  key         String
  name        String
  size        Int          @default(0)
  mime        String       @default("")
  resources   Resource[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
