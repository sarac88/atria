// Atria LMS — data model (architecture doc §5). This slice exposes only
// auth/users/classes, but the full relational model is defined so migrations
// stay stable across later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  docente
  alumno
  admin
}

enum ClassStatus {
  live
  scheduled
  draft
}

enum EnrollmentRole {
  teacher
  student
}

enum InvitationStatus {
  pending
  accepted
}

enum ActivityType {
  tarea
  cuestionario
  proyecto
  ensayo
  debate
}

enum SubmissionStatus {
  entregado
  pendiente
  atrasado
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               Role         @default(alumno)
  avatarUrl          String?
  hashedRefreshToken String?
  ownedClasses       Class[]                   @relation("ClassOwner")
  enrollments        Enrollment[]
  invitationsSent    ClassInvitation[]         @relation("InvitedBy")
  submissions        Submission[]
  messages           Message[]
  gradesGiven        Grade[]                   @relation("GradedBy")
  conversations      ConversationParticipant[]
  notifications      Notification[]
  debatePosts        DebatePost[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String    @default("")
  link      String?
  entityId  String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
}

model Class {
  id            String         @id @default(cuid())
  name          String
  code          String
  room          String         @default("")
  subject       String         @default("")
  color         String         @default("var(--primary-500)")
  icon          String         @default("academic-cap")
  status        ClassStatus    @default(draft)
  progress      Float          @default(0)
  nextSession   String         @default("Sin programar")
  desc          String         @default("")
  coverUrl      String         @default("")
  studentsCount Int            @default(0)
  openActivities Int           @default(0)
  pending       Int            @default(0)
  ownerId       String
  owner         User           @relation("ClassOwner", fields: [ownerId], references: [id])
  enrollments   Enrollment[]
  invitations   ClassInvitation[]
  modules       Module[]
  activities    Activity[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Enrollment {
  id          String         @id @default(cuid())
  userId      String
  classId     String
  roleInClass EnrollmentRole @default(student)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, classId])
}

/// Invitación de un docente a un correo para matricularse en su clase. El token
/// viaja en el enlace que el docente comparte; una invitación aceptada deja de
/// ser utilizable y su matrícula pasa a Enrollment. Revocar borra la fila, de
/// modo que volver a invitar al mismo correo reutiliza la clave [classId, email].
model ClassInvitation {
  id          String           @id @default(cuid())
  classId     String
  email       String
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  /// Último envío correcto por correo, o null si sólo se compartió el enlace a mano.
  emailSentAt DateTime?
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([classId, email])
  @@index([email])
}

model Module {
  id          String          @id @default(cuid())
  classId     String
  title       String
  description String          @default("")
  position    Int             @default(0)
  done        Boolean         @default(false)
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  resources   Resource[]
  sessions    OnlineSession[]
  activities  Activity[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Enlace de videollamada de una unidad (Zoom, Meet, Teams…). Sin startsAt es
/// una sala permanente, siempre disponible.
model OnlineSession {
  id        String    @id @default(cuid())
  moduleId  String
  provider  String    @default("other")
  label     String
  url       String
  startsAt  DateTime?
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([moduleId])
}

model Resource {
  id        String   @id @default(cuid())
  moduleId  String
  type      String
  label     String
  meta      String   @default("")
  state     String   @default("")
  url       String   @default("")
  fileId    String?
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  file      File?    @relation(fields: [fileId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id           String       @id @default(cuid())
  classId      String
  moduleId     String?
  type         ActivityType @default(tarea)
  title        String
  instructions String       @default("")
  dueAt        String       @default("")
  dueDate      DateTime?
  points       Float        @default(0)
  format       String       @default("Archivo")
  allowLate    Boolean      @default(true)
  config       Json         @default("{}")
  status       ClassStatus  @default(live)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  debatePosts  DebatePost[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Una intervención en una actividad de tipo debate. Las respuestas cuelgan de
/// un post raíz mediante parentId (un solo nivel de anidamiento).
model DebatePost {
  id         String       @id @default(cuid())
  activityId String
  authorId   String
  parentId   String?
  body       String
  activity   Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     DebatePost?  @relation("DebateReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DebatePost[] @relation("DebateReplies")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([activityId])
}

model Submission {
  id          String           @id @default(cuid())
  activityId  String
  studentId   String
  status      SubmissionStatus @default(pendiente)
  submittedAt DateTime?
  fileId      String?
  fileName    String?
  comment     String?
  answers     Json?
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file        File?            @relation(fields: [fileId], references: [id])
  grade       Grade?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([activityId, studentId])
}

model Grade {
  id           String     @id @default(cuid())
  submissionId String     @unique
  score        Float
  feedback     String     @default("")
  gradedById   String?
  gradedAt     DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy     User?      @relation("GradedBy", fields: [gradedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Conversation {
  id           String                    @id @default(cuid())
  type         String                    @default("direct")
  classId      String?
  title        String                    @default("")
  class        Class?                    @relation(fields: [classId], references: [id])
  messages     Message[]
  participants ConversationParticipant[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  /// Fecha de la última reescritura del autor, o null si nunca se editó.
  editedAt       DateTime?
  /// Borrado lógico: la fila se conserva pero deja de mostrarse en el hilo.
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model File {
  id          String       @id @default(cuid())
  ownerId     String
  key         String
  name        String
  size        Int          @default(0)
  mime        String       @default("")
  resources   Resource[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
