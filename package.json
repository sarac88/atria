{
  "name": "atria",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev --workspace @atria/web",
    "dev:api": "npm run start:dev --workspace @atria/api",
    "build": "npm run build --workspace @atria/types && npm run build --workspace @atria/api && npm run build --workspace @atria/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @atria/api",
    "db:migrate": "npm run db:migrate --workspace @atria/api",
    "db:seed": "npm run db:seed --workspace @atria/api"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5"
  }
}
